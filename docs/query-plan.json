  "sql": "SELECT sum(order_items.quantity * order_items.unit_price_cents - order_items.discount_cents) AS revenue, count(DISTINCT orders.id) AS orders, sum(order_items.quantity) AS units, CAST(timezone(%(timezone_1)s::VARCHAR, orders.occurred_at) AS DATE) AS day \nFROM orders JOIN order_items ON order_items.tenant_id = orders.tenant_id AND order_items.order_id = orders.id JOIN coverage ON coverage.tenant_id = orders.tenant_id AND coverage.store_id = orders.store_id AND coverage.date = CAST(timezone(%(timezone_1)s::VARCHAR, orders.occurred_at) AS DATE) \nWHERE orders.tenant_id = %(tenant_id_1)s::VARCHAR AND order_items.tenant_id = %(tenant_id_2)s::VARCHAR AND coverage.tenant_id = %(tenant_id_3)s::VARCHAR AND orders.store_id IN (%(store_id_1_1)s::VARCHAR) AND coverage.store_id IN (%(store_id_2_1)s::VARCHAR) AND orders.occurred_at >= %(occurred_at_1)s::TIMESTAMP WITH TIME ZONE AND orders.occurred_at < %(occurred_at_2)s::TIMESTAMP WITH TIME ZONE AND orders.status = %(status_1)s::VARCHAR GROUP BY CAST(timezone(%(timezone_1)s::VARCHAR, orders.occurred_at) AS DATE)",
