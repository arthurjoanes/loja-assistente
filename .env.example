FRONTEND_PORT=3102
BACKEND_PORT=8102
DEMO_MODE=true
SESSION_SECRET=replace-with-random-project-only-secret
POSTGRES_PASSWORD=local-demo-only-change-for-shared-environments
COOKIE_SECURE=false
LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
# Azure: use https://SEU-RECURSO.openai.azure.com/openai/v1/ e OPENAI_MODEL=NOME-DO-DEPLOYMENT.
OPENAI_BASE_URL=https://api.openai.com/v1/
# Deixe vazio para modelos sem reasoning; GPT-5.6 aceita none para extração curta.
OPENAI_REASONING_EFFORT=
REFERENCE_DATE=2026-08-17
DATASET_VERSION=synthetic-v1
LOCAL_UID=1000
LOCAL_GID=1000
